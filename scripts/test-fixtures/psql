#!/usr/bin/env bash
# 测试用的桩 psql：记录调用、维护假账本，不连任何数据库。
# 通过把本目录放到 PATH 最前面来顶替真正的 psql。
set -uo pipefail

STATE="${STUB_STATE:?STUB_STATE not set}"
LOG="${STUB_LOG:?STUB_LOG not set}"

echo "psql $*" >> "$LOG"

file=""
sql=""
psql_var=""

while [ $# -gt 0 ]; do
  case "$1" in
    -f) file="$2"; shift 2 ;;
    -c) sql="$2"; shift 2 ;;
    -v|--variable)
      case "$2" in
        v=*) psql_var="${2#v=}" ;;
      esac
      shift 2 ;;
    -*) shift ;;
    *) shift ;;
  esac
done

stdin_data=""
if [ ! -t 0 ]; then
  stdin_data="$(cat)"
fi
combined="$sql$stdin_data"

if [ -n "$file" ]; then
  base="$(basename "$file")"
  echo "[stub] EXECUTE $base" >> "$LOG"
  # 文件名里带 explode 的用来模拟执行失败。
  if [[ "$base" == *explode* ]]; then
    echo "[stub] simulated failure in $base" >&2
    exit 1
  fi
  echo "$base" >> "$STATE"
  exit 0
fi

case "$combined" in
  *"select version from public.schema_migrations"*)
    [ -f "$STATE" ] && cat "$STATE"
    exit 0
    ;;
  *"insert into public.schema_migrations"*)
    if [ -z "$psql_var" ]; then
      echo "[stub] insert without -v v=... ; refusing" >&2
      exit 1
    fi
    echo "$psql_var" >> "$STATE"
    exit 0
    ;;
  *"create table if not exists public.schema_migrations"*)
    exit 0
    ;;
  *"notify pgrst"*)
    echo "[stub] reload schema" >> "$LOG"
    exit 0
    ;;
esac

exit 0
