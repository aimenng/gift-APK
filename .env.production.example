# Production / Android build env for the frontend (Vite).
#
# `vite build` runs in production mode, so it loads .env.production — NOT .env.development,
# and NOT .env.android.example (Vite never loads that filename). Copy this file to
# .env.production and fill in your real backend URL before running `npm run build:mobile`.
#
# This file is committed to the repo. Only put public URLs here — never any secret key.
# In particular SUPABASE_SERVICE_ROLE_KEY belongs in backend/.env and must never appear
# in any VITE_* variable, since those get baked into the client bundle.

# Required for native (APK) builds: absolute URL the phone can actually reach.
# Must not be /api, localhost, 127.0.0.1 or 10.0.2.2 — `npm run check:native-env` rejects those.
VITE_API_BASE_URL_MOBILE=https://your-backend-domain.com/api

# Used by the web build (Vercel). A relative /api is correct there because vercel.json
# routes /api to the serverless function on the same origin.
VITE_API_BASE_URL=/api
